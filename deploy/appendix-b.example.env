# Sarva R1 — Appendix B (off vs live) — copy to deployment env / release notes
# See Requirement/SARVA-REQUIREMENTS.md and SARVA-DESIGN.md (integrations / delivery).

INTEGRATION_MCP_GIT=off
# MCP Git: off | live (live requires GIT_MCP_ENDPOINT)
# GIT_MCP_ENDPOINT=https://mcp-git.example.com
INTEGRATION_JIRA=absent
# CI/CD pipelines: defer Phase 1 exit; Phase 2 live per FRD §5
INTEGRATION_CICD=defer
INTEGRATION_EMAIL=defer
# Execution adapters: at least one category live for Phase 1
INTEGRATION_EXECUTION_ADAPTER=live
# Pre-push verify (§4.1.4): live when enabled on project
INTEGRATION_PRE_PUSH_VERIFY=live_when_enabled
# PM orchestrator propose path
INTEGRATION_PM_ORCHESTRATOR=live
# PM propose uses LLM by default (provider connection + model binding). Disable only if propose should hard-fail.
# PM_PROPOSE_USE_LLM=true
# PM_PROPOSE_E2E_STUB must stay false in production (Playwright/CI only).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLAMA_API_URL=  LLAMA_API_KEY=  (hosted Meta/Llama inference, if used)
