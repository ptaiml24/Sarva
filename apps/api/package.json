{
  "name": "@sarva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:clean-sample": "tsx prisma/clean-sample-data.ts",
    "db:purge-test-users": "tsx prisma/purge-automation-users.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "ping:gemini": "tsx scripts/ping-google-binding.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.12",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.3.0",
    "@prisma/client": "^6.3.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
