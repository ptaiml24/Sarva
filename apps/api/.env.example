# Point at your local cluster (no Docker required). Examples:
#   postgresql://sarva:sarva_dev@localhost:5432/sarva   ← matches scripts/postgres/bootstrap-dev.sql + docker-compose
#   postgresql://YOUR_OS_USERNAME@localhost:5432/sarva  ← common Homebrew/mac (peer or password auth)
DATABASE_URL="postgresql://sarva:sarva_dev@localhost:5432/sarva"
JWT_SECRET="dev-only-change-me-32chars-min!!"
PORT=3000
NODE_ENV=development
# off = no MCP calls (default); live requires GIT_MCP_ENDPOINT
INTEGRATION_MCP_GIT=off
# GIT_MCP_ENDPOINT=https://your-mcp-git-gateway.example.com
PRE_PUSH_VERIFY_TIMEOUT_MS=1200000
MCP_GIT_TIMEOUT_MS=30000
# PM propose: requires LLM + model binding when true (default). Set false to hard-disable propose.
PM_PROPOSE_USE_LLM=true
# Playwright/CI only — never in production. Skips provider HTTP and creates stub drafts.
# PM_PROPOSE_E2E_STUB=false
# Board publish (SDM plan): uses same bindings as design (SDM → PM → company) when true.
# PM_PLAN_BOARD_USE_LLM=true
# PM_PLAN_BOARD_E2E_STUB=false
# Coder agents (on claim / begin-execution): assignee’s model binding + chat completion → task.agentGeneratedBody
# AGENT_CODER_USE_LLM=true
# AGENT_CODER_E2E_STUB=false
# Max concurrent coder runs for orchestration-triggered batches (begin execution / phase unlock).
# AGENT_CODER_MAX_PARALLEL_RUNS=4
# Absolute path on the API machine for per-project dev folders (optional).
# SARVA_AGENT_WORKSPACE=/var/sarva-workspaces
# Post-completion / manual workspace verify: `npm install` + `npm run build` timeout (ms). Default 900000 (15m).
# SARVA_WORKSPACE_BUILD_TIMEOUT_MS=900000
# Allow POST .../delivery/workspace-git-push (git add/commit/push in dev workspace on API host). Requires git + credentials there.
# SARVA_WORKSPACE_GIT_PUSH=false
# Optional metadata for automated commits from that endpoint:
# SARVA_GIT_AUTHOR_NAME=Sarva
# SARVA_GIT_AUTHOR_EMAIL=sarva@users.noreply.localhost
# SDM handoff text when a task enters review (uses design/SDM binding when true).
# AGENT_REVIEW_HANDOFF_USE_LLM=true
# AGENT_REVIEW_HANDOFF_E2E_STUB=false
# Automated reviewer agent (after coder submits): LLM verdict approve vs request_changes; chains coder until cap. Default true in schema; set false to require manual Approve/Request changes.
# AGENT_AUTOMATED_REVIEW=true
# AGENT_AUTOMATED_REVIEW_E2E_STUB=false
# Maximum review→implementer bounces (persisted `review_revision_count`); enforced for manual Request changes too when env is wired.
# AGENT_AUTOMATED_REVIEW_MAX_ROUNDS=5
# Automatically re-run coder LLM after Request changes (manual or automated).
# AGENT_CODER_ON_REVIEW_FEEDBACK=true
# After Begin execution: count automation stalls on policy; ≥ threshold unlocks full board (default 4 = after >3 stalls).
# AGENT_AUTONOMOUS_STALL_OPERATOR_THRESHOLD=4
# Cursor Agent SDK (optional — also storable on LlmProviderConnection)
# https://cursor.com/dashboard/integrations
# CURSOR_API_KEY=cursor_...
# Local runs: working directory on the API host (when connection has no https Git base URL)
# CURSOR_AGENT_LOCAL_CWD=/path/to/checkout
# Cloud runs: clone this repo if connection Base URL is empty
# CURSOR_CLOUD_REPO_URL=https://github.com/org/repo
# CURSOR_CLOUD_REPO_REF=main
# Design generate-llm: only the newest prior draft is embedded in full (capped); older runs = titles only.
# DESIGN_GENERATE_PRIOR_ANCHOR_MAX_CHARS=18000
# DESIGN_GENERATE_PRIOR_TITLE_LIST_MAX=7
